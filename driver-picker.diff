diff --git a/nxnative/dm/android/java/org/nx2a/DriverPickerActivity.java b/nxnative/dm/android/java/org/nx2a/DriverPickerActivity.java
new file mode 100644
index 0000000..4156f6f
--- /dev/null
+++ b/nxnative/dm/android/java/org/nx2a/DriverPickerActivity.java
@@ -0,0 +1,293 @@
+package org.nx2a;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.opengl.EGL14;
+import android.opengl.EGLConfig;
+import android.opengl.EGLContext;
+import android.opengl.EGLDisplay;
+import android.opengl.EGLSurface;
+import android.opengl.GLES20;
+import android.os.Bundle;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.RadioButton;
+import android.widget.RadioGroup;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileReader;
+import java.io.FileWriter;
+import java.io.InputStreamReader;
+import java.util.ArrayList;
+
+/**
+ * A Vulkan driver choice on launch (porter --driver-picker): the app opens this
+ * instead of starting the game at once. The player picks one of the drivers the
+ * APK carries, or the device's own driver, and the choice is written to env.txt's
+ * DM_VK_DRIVER row (porter/driver.py's env_with_driver, same rules) before the
+ * game's activity starts. It shows on every launch, with the last choice
+ * pre-selected: one tap to play, and a driver that force-closes the game is
+ * always one relaunch away from another.
+ *
+ * The packed drivers come from the picker.tsv asset (porter writes it): an
+ * activity= row with the game's NativeActivity class, then a driver= row per
+ * driver, lib name | label | GPU match tokens (exact models like 710 or G57,
+ * or Adreno families like 7xx). The GPU is read through a throwaway EGL
+ * context and the best-matching driver is pre-selected (an exact model beats
+ * a family match); without a match the current env.txt choice is, then the
+ * system's driver when the GPU's family is known but no packed driver serves
+ * it (a Mali CSF GPU against a PanVK build for older models, or an Adreno
+ * generation too new for the packed Turnip builds), then the first driver.
+ * The system's driver is always offered as the escape hatch.
+ */
+public class DriverPickerActivity extends Activity {
+    private static final String ROW = "DM_VK_DRIVER";
+
+    private static class Driver {
+        final String lib, label, family;
+        Driver(String lib, String label, String family) { this.lib = lib; this.label = label; this.family = family; }
+    }
+
+    private final ArrayList<Driver> drivers = new ArrayList<Driver>();
+    private String gameActivity = "org.nx2a.GameActivity";
+    private String selected;   // the picked lib name, or "" for the system's driver
+    private File envFile;
+
+    @Override protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        readPickerAsset();
+        File files = getExternalFilesDir(null);
+        envFile = files == null ? null : new File(files, "env.txt");
+        String gpu = gpuRenderer();
+        String[] info = gpuInfo(gpu);   // {number, family}: {"735", "7xx"} for Adreno, {"G57", "mali"} for Mali, {null, null} otherwise
+        String number = info[0], family = info[1];
+        String current = envDriver();
+
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setBackgroundColor(Color.parseColor("#121212"));
+        int pad = dp(24);
+        root.setPadding(pad, pad, pad, pad);
+        root.setLayoutParams(new ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+
+        TextView title = new TextView(this);
+        ApplicationInfo app = getApplicationInfo();
+        title.setText(app.loadLabel(getPackageManager()) + " - Vulkan driver");
+        title.setTextColor(Color.WHITE);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 20);
+        title.setTypeface(Typeface.DEFAULT_BOLD);
+        root.addView(title);
+
+        TextView gpuView = new TextView(this);
+        gpuView.setText(gpu == null ? "GPU: unknown" : "GPU: " + gpu);
+        gpuView.setTextColor(Color.parseColor("#AAAAAA"));
+        gpuView.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        gpuView.setPadding(0, dp(8), 0, dp(20));
+        root.addView(gpuView);
+
+        final RadioGroup group = new RadioGroup(this);
+        group.setOrientation(RadioGroup.VERTICAL);
+        // the system's driver first: it always works, and it is the escape hatch
+        addOption(group, "", "System driver", "the device's own Vulkan driver", family == null);
+        for (Driver d : drivers) {
+            boolean recommended = matchScore(d.family, number, family) > 0;
+            String hint = d.family.isEmpty() ? d.lib : d.family.replace(",", "/") + " - " + d.lib;
+            addOption(group, d.lib, d.label + (recommended ? " (recommended)" : ""), hint, false);
+        }
+        root.addView(group);
+
+        // pre-select: the GPU's best match, else the env.txt choice, else the system's driver when the GPU's family is known but no packed driver serves it,
+        // else the first driver
+        selected = null;
+        int best = 0;
+        for (Driver d : drivers) {
+            int s = matchScore(d.family, number, family);
+            if (s > best) { best = s; selected = d.lib; }
+        }
+        if (selected == null && current != null) selected = current;
+        if (selected == null && family != null) selected = "";
+        if (selected == null && !drivers.isEmpty()) selected = drivers.get(0).lib;
+        if (selected == null) selected = "";
+        for (int i = 0; i < group.getChildCount(); i++) {
+            RadioButton b = (RadioButton) group.getChildAt(i);
+            if (selected.equals(b.getTag())) { b.setChecked(true); break; }
+        }
+        group.setOnCheckedChangeListener(new RadioGroup.OnCheckedChangeListener() {
+            @Override public void onCheckedChanged(RadioGroup g, int id) {
+                View v = g.findViewById(id);
+                if (v != null) selected = (String) v.getTag();
+            }
+        });
+
+        Button play = new Button(this);
+        play.setText("PLAY");
+        play.setTextColor(Color.WHITE);
+        play.setTextSize(TypedValue.COMPLEX_UNIT_SP, 18);
+        play.setTypeface(Typeface.DEFAULT_BOLD);
+        play.setBackgroundColor(Color.parseColor("#E10600"));
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        lp.topMargin = dp(28);
+        play.setLayoutParams(lp);
+        play.setGravity(Gravity.CENTER);
+        play.setOnClickListener(new View.OnClickListener() {
+            @Override public void onClick(View v) { play(); }
+        });
+        root.addView(play);
+
+        setContentView(root);
+    }
+
+    private void addOption(RadioGroup group, String tag, String label, String hint, boolean checked) {
+        RadioButton b = new RadioButton(this);
+        b.setTag(tag);
+        b.setText(label + "\n" + hint);
+        b.setTextColor(Color.WHITE);
+        b.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
+        b.setPadding(dp(8), dp(10), dp(8), dp(10));
+        b.setChecked(checked);
+        group.addView(b);
+    }
+
+    private void play() {
+        if (!writeEnv(selected)) Toast.makeText(this, "Could not save the driver choice; the game starts with its previous driver", Toast.LENGTH_LONG).show();
+        try {
+            startActivity(new Intent(this, Class.forName(gameActivity)));
+        } catch (ClassNotFoundException e) {
+            Toast.makeText(this, "The game's activity is missing: " + gameActivity, Toast.LENGTH_LONG).show();
+            return;
+        }
+        finish();
+    }
+
+    /** env.txt with its DM_VK_DRIVER row naming lib, in place of the old row (appended when there was none), or dropped when lib is "" (the system's driver) */
+    private boolean writeEnv(String lib) {
+        if (envFile == null) return false;
+        try {
+            ArrayList<String> out = new ArrayList<String>();
+            boolean done = false;
+            if (envFile.isFile()) {
+                BufferedReader r = new BufferedReader(new FileReader(envFile));
+                String ln;
+                while ((ln = r.readLine()) != null) {
+                    if (ln.trim().startsWith(ROW + "=")) {
+                        if (!lib.isEmpty() && !done) { out.add(ROW + "=" + lib); done = true; }
+                        continue;
+                    }
+                    out.add(ln);
+                }
+                r.close();
+            }
+            if (!lib.isEmpty() && !done) out.add(ROW + "=" + lib);
+            if (out.isEmpty()) return true;   // the system's driver and no env.txt yet: nothing to write
+            FileWriter w = new FileWriter(envFile);
+            for (String l : out) { w.write(l); w.write("\n"); }
+            w.close();
+            return true;
+        } catch (Exception e) { return false; }
+    }
+
+    private String envDriver() {
+        if (envFile == null || !envFile.isFile()) return null;
+        try {
+            BufferedReader r = new BufferedReader(new FileReader(envFile));
+            String ln;
+            while ((ln = r.readLine()) != null) {
+                ln = ln.trim();
+                if (ln.startsWith(ROW + "=")) { r.close(); return ln.substring(ROW.length() + 1).trim(); }
+            }
+            r.close();
+        } catch (Exception e) { /* no env.txt yet: no current choice */ }
+        return null;
+    }
+
+    private void readPickerAsset() {
+        try {
+            BufferedReader r = new BufferedReader(new InputStreamReader(getAssets().open("picker.tsv"), "UTF-8"));
+            String ln;
+            while ((ln = r.readLine()) != null) {
+                if (ln.startsWith("activity=")) gameActivity = ln.substring("activity=".length()).trim();
+                else if (ln.startsWith("driver=")) {
+                    String[] f = ln.substring("driver=".length()).split("\\|", -1);
+                    if (f.length >= 2) drivers.add(new Driver(f[0].trim(), f[1].trim(), f.length > 2 ? f[2].trim() : ""));
+                }
+            }
+            r.close();
+        } catch (Exception e) { /* no picker.tsv: only the system's driver is offered */ }
+    }
+
+    /** the GPU's renderer string through a throwaway EGL context, or null */
+    private static String gpuRenderer() {
+        EGLDisplay dpy = EGL14.eglGetDisplay(EGL14.EGL_DEFAULT_DISPLAY);
+        int[] major = new int[1], minor = new int[1];
+        if (dpy == EGL14.EGL_NO_DISPLAY || !EGL14.eglInitialize(dpy, major, 0, minor, 0)) return null;
+        try {
+            int[] cfgAttribs = { EGL14.EGL_SURFACE_TYPE, EGL14.EGL_PBUFFER_BIT, EGL14.EGL_RENDERABLE_TYPE, EGL14.EGL_OPENGL_ES2_BIT,
+                    EGL14.EGL_RED_SIZE, 8, EGL14.EGL_GREEN_SIZE, 8, EGL14.EGL_BLUE_SIZE, 8, EGL14.EGL_NONE };
+            EGLConfig[] configs = new EGLConfig[1];
+            int[] n = new int[1];
+            if (!EGL14.eglChooseConfig(dpy, cfgAttribs, 0, configs, 0, 1, n, 0) || n[0] == 0) return null;
+            int[] ctxAttribs = { EGL14.EGL_CONTEXT_CLIENT_VERSION, 2, EGL14.EGL_NONE };
+            EGLContext ctx = EGL14.eglCreateContext(dpy, configs[0], EGL14.EGL_NO_CONTEXT, ctxAttribs, 0);
+            if (ctx == EGL14.EGL_NO_CONTEXT) return null;
+            int[] surfAttribs = { EGL14.EGL_WIDTH, 1, EGL14.EGL_HEIGHT, 1, EGL14.EGL_NONE };
+            EGLSurface surf = EGL14.eglCreatePbufferSurface(dpy, configs[0], surfAttribs, 0);
+            if (surf == EGL14.EGL_NO_SURFACE || !EGL14.eglMakeCurrent(dpy, surf, surf, ctx)) return null;
+            String renderer = GLES20.glGetString(GLES20.GL_RENDERER);
+            EGL14.eglMakeCurrent(dpy, EGL14.EGL_NO_SURFACE, EGL14.EGL_NO_SURFACE, EGL14.EGL_NO_CONTEXT);
+            EGL14.eglDestroySurface(dpy, surf);
+            EGL14.eglDestroyContext(dpy, ctx);
+            return renderer;
+        } finally { EGL14.eglTerminate(dpy); }
+    }
+
+    /** The GPU's {number, family}: "Adreno (TM) 735" -> {"735", "7xx"}, "Mali-G57 MC2" -> {"G57", "mali"}; {null, null} when the GPU is neither */
+    private static String[] gpuInfo(String renderer) {
+        String[] none = { null, null };
+        if (renderer == null) return none;
+        String r = renderer.toLowerCase();
+        if (r.contains("adreno")) {
+            for (int i = 0; i + 2 < r.length(); i++) {
+                char c = r.charAt(i);
+                if (c >= '6' && c <= '8' && Character.isDigit(r.charAt(i + 1)) && Character.isDigit(r.charAt(i + 2))) {
+                    String number = r.substring(i, i + 3);
+                    return new String[] { number, number.charAt(0) + "xx" };
+                }
+            }
+        }
+        if (r.contains("mali")) {
+            int g = r.indexOf('g');
+            while (g >= 0 && g + 3 <= r.length()) {
+                if (Character.isDigit(r.charAt(g + 1)) && Character.isDigit(r.charAt(g + 2))) {
+                    int end = g + 3;
+                    while (end < r.length() && Character.isDigit(r.charAt(end))) end++;
+                    return new String[] { "G" + r.substring(g + 1, end), "mali" };
+                }
+                g = r.indexOf('g', g + 1);
+            }
+        }
+        return none;
+    }
+
+    /** how well a driver's match tokens fit this GPU: 2 for an exact model (710), 1 for a family (7xx), 0 for no match */
+    private static int matchScore(String tokens, String number, String family) {
+        if (tokens == null || tokens.isEmpty()) return 0;
+        String t = "," + tokens + ",";
+        if (number != null && t.contains("," + number + ",")) return 2;
+        if (family != null && t.contains("," + family + ",")) return 1;
+        return 0;
+    }
+
+    private int dp(int v) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, getResources().getDisplayMetrics());
+    }
+}
